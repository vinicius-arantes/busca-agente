# Chave da API do Groq (https://console.groq.com/keys)
GROQ_API_KEY=coloque_sua_chave_aqui
# Modelo (precisa suportar tool calling)
GROQ_MODEL=openai/gpt-oss-120b
# Requisições por segundo (limitador compartilhado entre os agentes)
GROQ_RPS=0.45
# Esforço de raciocínio (modelos gpt-oss): low | medium | high
GROQ_REASONING_EFFORT=low
